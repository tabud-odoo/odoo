<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_qfpay" model="ir.ui.view">
        <field name="name">payment.provider.form.qfpay</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'qfpay'">
                    <field name="qfpay_app_code" string="App Code" required="code == 'qfpay' and state != 'disabled'"/>
                    <field name="qfpay_app_key" string="App Key" password="True" required="code == 'qfpay' and state != 'disabled'"/>
                    <field name="qfpay_mchntid" string="Merchant ID"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
